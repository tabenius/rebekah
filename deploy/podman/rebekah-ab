#!/usr/bin/env bash
# A/B activation for a Rebekah instance.
#
#   B  the last verified-good image, written only after a verification passes
#   A  the candidate now running
#
# Activate A, then verify that it actually works. On success copy A to B; on
# failure restore B and verify that too.
#
# The gate is verification, not liveness. A container that starts, reports
# healthy and serves nothing is a failure, not a success: that is exactly how a
# stale image outlived a full test suite once. Each check below asks whether
# the service is doing its job.
#
#   rebekah-ab status              show A, B and the last outcome
#   rebekah-ab activate IMAGE      promote IMAGE to A, verify, keep or revert
#   rebekah-ab rollback            return to B and verify
#   rebekah-ab verify              verify A without changing anything
#   rebekah-ab --dry-run ...       print what would happen and change nothing
#
# Read-only except for `activate` and `rollback`, which restart the service.
set -euo pipefail

name="${REBEKAH_NAME:-rebekah}"
runtime="${CONTAINER_RUNTIME:-podman}"
unit="${REBEKAH_UNIT:-rebekah.service}"
env_file="${REBEKAH_ENV_FILE:-$HOME/.config/rebekah/rebekah.env}"
state_dir="$(dirname -- "$env_file")"
# B is the last verified-good image. Kept beside the env file, never inside
# the image, so rolling back does not depend on the candidate being startable.
good_file="$state_dir/last-good-image"
history="$state_dir/ab-history.log"
dry_run=0
[[ "${1:-}" == "--dry-run" ]] && { dry_run=1; shift; }

log() { printf 'rebekah-ab: %s\n' "$*" >&2; }

current_pin() {
  sed -n 's/^REBEKAH_IMAGE=//p' "$env_file" 2>/dev/null | tail -1
}

write_pin() {
  local pin="$1" tmp
  tmp="$(mktemp "$env_file.XXXXXX")"
  if grep -q '^REBEKAH_IMAGE=' "$env_file"; then
    sed "s|^REBEKAH_IMAGE=.*|REBEKAH_IMAGE=$pin|" "$env_file" > "$tmp"
  else
    cp "$env_file" "$tmp"; printf 'REBEKAH_IMAGE=%s\n' "$pin" >> "$tmp"
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$env_file"
}

remember() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$history" 2>/dev/null || true; }

restart() {
  systemctl --user restart "$unit" >/dev/null 2>&1 || return 1
}

# Wait for the container to answer, rather than sleeping a fixed amount: a slow
# machine is not a failure, and a fast one should not be made to wait.
wait_ready() {
  local deadline=$((SECONDS + ${AB_WAIT_SECONDS:-120}))
  while (( SECONDS < deadline )); do
    if "$runtime" exec "$name" rebekah-health >/dev/null 2>&1; then return 0; fi
    sleep 3
  done
  return 1
}

# Does the gateway answer, and does it answer with something usable?
verify() {
  local label="$1"
  if ! "$runtime" exec "$name" rebekah-health >/dev/null 2>&1; then
    log "FAIL [$label] services are not healthy"; return 1
  fi
  local token status
  token="$("$runtime" exec "$name" cat /run/rebekah/gateway-token 2>/dev/null | tr -d '\r\n')" || token=""
  [[ -n "$token" ]] || { log "FAIL [$label] no gateway token"; return 1; }
  status="$("$runtime" exec "$name" sh -c \
    'curl -s -o /dev/null -w "%{http_code}" --max-time 8 -H "Authorization: Bearer $(cat /run/rebekah/gateway-token)" http://127.0.0.1:8080/healthz' \
    2>/dev/null | tr -d '\r\n')" || status=""
  [[ "$status" == "200" ]] || { log "FAIL [$label] gateway healthz returned '${status:-none}'"; return 1; }

  # When an agenda edition is mounted, the gateway must actually serve it.
  # This is the check that catches a stale image: it starts, is healthy, and
  # answers `unavailable` for every edition.
local agenda="${REBEKAH_DAILY_AGENDA_HOST_DIR:-}"
    if [[ -n "$agenda" && -f "$agenda/manifest.json" ]]; then
      local view
      view="$("$runtime" exec "$name" sh -c \
        'curl -s --max-time 10 -H "Authorization: Bearer $(cat /run/rebekah/gateway-token)" http://127.0.0.1:8080/api/v1/daily-agenda' \
        2>/dev/null)" || view=""
      if [[ -z "$view" ]]; then
        log "FAIL [$label] the agenda view returned nothing"; return 1
      fi
      local agenda_status
      # Read the top-level key with a real JSON parser. A pattern match would be
      # unreliable here: the payload nests objects that carry their own "status",
      # and jq ships in the image.
      agenda_status="$(printf '%s' "$view" \
        | "$runtime" exec -i "$name" jq -r '.status // ""' 2>/dev/null | tr -d '\r\n')" || agenda_status=""
      case "$agenda_status" in
        ready|not-configured) : ;;
        *) log "FAIL [$label] agenda view is '${agenda_status:-unparseable}', not ready"; return 1 ;;
      esac

      # Serving "ready" is not enough. An image from before the contract check
      # serves it happily while silently ignoring half the projection, so the
      # edition's own contract is compared with what this gateway accepts.
      local edition_contract gateway_contracts
      edition_contract="$(jq -r '.generator_contract // ""' "$agenda/manifest.json" 2>/dev/null || true)"
      # The image has grep but no sed, so extract with grep and strip the
      # punctuation host-side. An empty result is a genuine absence: a gateway
      # from before the contract check has no such line at all.
      gateway_contracts="$("$runtime" exec "$name" grep -h '^AGENDA_CONTRACTS' \
        /usr/local/lib/rebekah/gateway.py 2>/dev/null \
        | tr -d ' \n{}"=' )" || gateway_contracts=""
      gateway_contracts="${gateway_contracts#AGENDA_CONTRACTS}"
      if [[ -n "$edition_contract" ]]; then
        if [[ -z "$gateway_contracts" ]]; then
          log "FAIL [$label] the gateway declares no agenda contract; it predates $edition_contract"
          return 1
        fi
        if [[ "$gateway_contracts" != *"$edition_contract"* ]]; then
          log "FAIL [$label] gateway accepts [$gateway_contracts], edition is $edition_contract"
          return 1
        fi
      fi
    fi
  log "OK [$label] healthy, gateway answering${agenda:+, agenda serving}"
  return 0
}

do_activate() {
  local candidate="$1" previous good
  previous="$(current_pin)"
  good="$(cat "$good_file" 2>/dev/null || true)"
  [[ -n "$candidate" ]] || { log "activate needs an image reference"; return 2; }
  log "A=$candidate  B=${good:-none}  previous=${previous:-none}"

  # Refuse to record a B that is not verified good, or a lost reference turns
  # the next failure into a dead end.
  if [[ -z "$good" && -n "$previous" ]]; then
    if verify "previous" ; then
      printf '%s\n' "$previous" > "$good_file"; chmod 600 "$good_file"
      good="$previous"
      log "seeded B with the currently running image"
    else
      log "WARN the running image is not healthy; B stays unset and a failure cannot be reverted"
    fi
  fi

  if (( dry_run )); then log "dry run: would set A=$candidate, restart and verify"; return 0; fi

  write_pin "$candidate"
  remember "activate $candidate (previous $previous)"
  log "restarting with A"
  if restart && wait_ready && verify "A"; then
    printf '%s\n' "$candidate" > "$good_file"; chmod 600 "$good_file"
    remember "promoted $candidate to B"
    log "A verified; B := $candidate"
    return 0
  fi
  log "A did not verify"
  if [[ -z "$good" ]]; then
    remember "FAILED $candidate; no B to revert to"
    log "no B recorded, so there is nothing to revert to; leaving A in place for inspection"
    return 1
  fi
  log "reverting to B=$good"
  write_pin "$good"
  restart || true
  if wait_ready && verify "B after rollback"; then
    remember "rolled back to $good"
    log "rolled back to B=$good and it verified"
    return 1
  fi
  remember "FAILED both A=$candidate and B=$good"
  log "BOTH A and B failed to verify. This is not a rollback success."
  log "A=$candidate is still pinned; the last known-good image is $good"
  return 3
}

do_rollback() {
  local good
  good="$(cat "$good_file" 2>/dev/null || true)"
  [[ -n "$good" ]] || { log "no B recorded; nothing to roll back to"; return 2; }
  if (( dry_run )); then log "dry run: would set A=$good, restart and verify"; return 0; fi
  log "rolling back to B=$good"
  write_pin "$good"; remember "rollback to $good"; restart || true
  if wait_ready && verify "B"; then return 0; fi
  log "B did not verify either; this is not a successful rollback"
  return 3
}

do_status() {
  printf 'A (running pin): %s\n' "$(current_pin || echo none)"
  printf 'B (last good):   %s\n' "$(cat "$good_file" 2>/dev/null || echo none)"
  printf 'env file:        %s\n' "$env_file"
  if (( dry_run )); then return 0; fi
  if "$runtime" exec "$name" rebekah-health >/dev/null 2>&1; then printf 'services:        healthy\n'
  else printf 'services:        NOT healthy\n'; fi
  [[ -f "$history" ]] && { printf -- '--- recent ---\n'; tail -5 "$history"; }
  return 0
}

command="${1:-status}"
case "$command" in
  status)   do_status ;;
  verify)   wait_ready && verify "A" ;;
  activate) do_activate "${2:-}" ;;
  rollback) do_rollback ;;
  *) log "unknown command: $command"; printf 'usage: rebekah-ab [--dry-run] status|verify|activate IMAGE|rollback\n' >&2; exit 2 ;;
esac