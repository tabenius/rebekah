{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebekah workspace handoff v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "sessionId",
    "repository",
    "artifact",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "required": [
        "url",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "worktree": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "ociDigest",
        "mediaType"
      ],
      "additionalProperties": false,
      "properties": {
        "ociDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "digest",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "observation",
              "assertion",
              "test",
              "attestation"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
